# =====================================================
# AgentCare Environment Example
# Copy this file to .env and fill in real values.
# Do not commit your real .env file.
# =====================================================

# =====================================================
# Application
# =====================================================
APP_NAME=AgentCare
APP_VERSION=1.0.0
DEBUG=true

SECRET_KEY=change-this-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# =====================================================
# Database
# =====================================================
# SQLite (default local)
DATABASE_URL=sqlite:///./agentcare.db

# PostgreSQL example
# DATABASE_URL=postgresql+psycopg2://username:password@localhost:5432/agentcare

# =====================================================
# LLM Provider Selection
# =====================================================
# Supported values in this project: mistral, groq
MODEL_PROVIDER=mistral

# =====================================================
# Mistral
# =====================================================
MISTRAL_API_KEY=your_mistral_api_key
MISTRAL_MODEL=open-mistral-7b

# =====================================================
# Groq
# =====================================================
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b

# =====================================================
# OpenAI (optional in this project)
# Note: Not required if you are using Mistral or Groq.
# =====================================================
OPENAI_API_KEY=

# =====================================================
# CrewAI
# =====================================================
CREW_VERBOSE=true
CREW_MEMORY=true
CREW_STORAGE_DIR=data/crewai

# =====================================================
# File Uploads
# =====================================================
UPLOAD_DIRECTORY=uploads
MAX_UPLOAD_SIZE_MB=10

# Allowed extensions are set in code; keep comma-separated list here for readability.
ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,doc,docx

# =====================================================
# Email
# =====================================================
ENABLE_EMAIL=false
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
SENDER_EMAIL=

# =====================================================
# Notifications
# =====================================================
REMINDER_HOURS_BEFORE=24
FOLLOWUP_DAYS_AFTER=30

# =====================================================
# Logging
# =====================================================
LOG_LEVEL=INFO
LOG_FILE=logs/agentcare.log

# =====================================================
# Security / Registration
# =====================================================
PASSWORD_MIN_LENGTH=8
ENABLE_REGISTRATION=true
